# Copie para .env no servidor da Hostinger e preencha. Nunca versione o .env real.
APP_NAME="Ricarte Prev Comercial"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://comercial.ricarteprev.com
APP_TIMEZONE=America/Fortaleza

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Banco MySQL criado no hPanel (Bancos de dados > MySQL). O host costuma ser "localhost".
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u316363488_comercial
DB_USERNAME=u316363488_comercial
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# E-mail criado no hPanel (Emails). Usado para redefinição de senha.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Cópias de segurança do banco: quantos dias manter
BACKUP_KEEP_DAYS=14

# Distância pelas estradas (OpenRouteService). Vazio = linha reta x fator de estrada
ORS_API_KEY=

# C2 Prev: API de Monitoramento (somente leitura). Vazio = integração desligada
C2_API_KEY=
C2_SNAPSHOT_TOKEN=
