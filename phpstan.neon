includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        # O trait é usado pelo componente Livewire de página única em
        # resources/views/pages/settings/profile.blade.php, que o PHPStan não analisa.
        -
            identifier: trait.unused
            path: app/Concerns/ProfileValidationRules.php
